{
  "name": "dsh-ascii-ocean",
  "version": "0.1.0",
  "private": true,
  "description": "ASCII shark ocean rendered as a living backdrop behind the New Session hero.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/client.js",
    "locale/*.json",
    "icon.svg"
  ],
  "license": "MIT"
}
