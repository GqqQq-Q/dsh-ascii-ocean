{
  "name": "dsh-ascii-ocean",
  "version": "0.6.5",
  "description": "ASCII ocean behind the New Session hero: sharks, hammerhead sharks, koi and goldfish drawn as character cells.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/client.js",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ascii-art",
    "animation",
    "canvas",
    "shark",
    "hammerhead"
  ],
  "license": "MIT"
}
