{
  "name": "dsh-ascii-ocean",
  "version": "0.5.0",
  "description": "Red koi and goldfish drawn with Chinese characters, swimming behind the session — the water can extend across the sidebar too.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/client.js",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ascii-art",
    "animation",
    "canvas",
    "koi"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/client.smoke.mjs"
  }
}
